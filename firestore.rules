rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile matching authenticated user ID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User's private academic classes
      match /classes/{classId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's private tasks and objectives
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

