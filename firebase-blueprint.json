{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with display call-sign and selected avatar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "operatorName": { "type": "string" },
        "avatar": { "type": "string" },
        "theme": { "type": "string" },
        "lang": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Class": {
      "title": "Class",
      "description": "An academic course node indexed by the operator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "code": { "type": "string" },
        "instructor": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "date"]
    },
    "Task": {
      "title": "Task",
      "description": "An operational academic assignment or task objective",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profile and operator settings document"
    },
    "/users/{userId}/classes/{classId}": {
      "schema": "Class",
      "description": "Classes belonging to a specific authenticated user"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks belonging to a specific authenticated user"
    }
  }
}
